# CivicPulse backend — multi-stage: build wheels, then a runtime with no compiler in it.
#
# The builder installs into a virtualenv that is copied wholesale into the runtime stage. The
# runtime therefore has no pip, no build toolchain and no wheel cache — smaller, and nothing a
# compromised process could use to compile something.

# ---------- stage 1: build ----------
# Digest-pinned: the tag python:3.12-slim moves on every patch release, and a base image that
# changes under you is one of the three things that differ between a laptop and a CI runner
# (§5.2 Q1).
FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f AS build

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

# psycopg[binary] ships wheels, so no libpq or gcc is needed even here. Kept explicit because
# swapping to non-binary psycopg would silently start needing build-essential.
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Dependency manifest before source: editing a route must not re-resolve and re-download every
# dependency. This ordering is the single biggest lever on rebuild time (§3.1 cache-friendly).
#
# requirements.txt is a lock file generated by `uv pip compile pyproject.toml`, and it is what
# the image installs — every transitive dependency pinned to an exact version, so the image
# built in CI contains what the image built on a laptop contains. pyproject.toml remains the
# source of truth for direct dependencies; scripts/check_submission.py verifies the two agree.
#
# The application itself is deliberately NOT pip-installed: it is copied in stage 2 and run
# from /app, so there is exactly one copy of the source in the final image.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# ---------- stage 2: runtime ----------
FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# No curl, no wget: the healthcheck below uses the Python interpreter that is already here.
# Installing curl would mean either an unpinned package (drifting between builds) or a pinned
# version that breaks the build the moment Debian supersedes it — and it would add packages to
# an image whose whole point is to carry only what it runs.

# A dedicated unprivileged user with no shell and no home: nothing to log into, and a process
# escape does not begin as root. UID is fixed so a Kubernetes runAsUser can match it.
RUN groupadd --gid 10001 civicpulse \
    && useradd --uid 10001 --gid civicpulse --no-create-home --shell /usr/sbin/nologin civicpulse

WORKDIR /app

COPY --from=build /opt/venv /opt/venv

# Source last, and owned by the app user rather than root.
COPY --chown=civicpulse:civicpulse alembic.ini ./
COPY --chown=civicpulse:civicpulse alembic ./alembic
COPY --chown=civicpulse:civicpulse app ./app

USER civicpulse

EXPOSE 8000

# Hits /health, which by design performs no I/O — so this reports on the process, not on
# Postgres. A healthcheck that pinged the database would make a slow query look like a dead
# container (see app/routes/health.py).
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).status == 200 else 1)"]

# Exec form, so uvicorn is PID 1 and receives SIGTERM directly. Via a shell it would not, and
# the graceful-shutdown handler in app/main.py would never run — every rolling update would
# drop in-flight requests (§2.2).
#
# One worker per container on purpose: replicas are the HPA's job, and multiple workers behind
# one set of resource requests makes utilisation-based autoscaling meaningless.
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "1", \
     "--timeout-graceful-shutdown", "25", \
     "--no-access-log"]
