# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# --- database ---
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=civicpulse
POSTGRES_HOST=database
POSTGRES_PORT=5432

# --- cache ---
REDIS_HOST=cache
REDIS_PORT=6379

# --- triage provider: llm | ollama | rules | simulated ---
TRIAGE_PROVIDER=rules

# Groq (free tier, no credit card): https://console.groq.com
# Leave blank unless TRIAGE_PROVIDER=llm. Never commit a real key.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (offline path, runs as a container in the compose stack)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# --- triage engineering knobs (assignment §2.5) ---
TRIAGE_TIMEOUT_SECONDS=10
TRIAGE_CACHE_TTL_SECONDS=86400
STATS_CACHE_TTL_SECONDS=30

# --- rate limiter on POST /api/complaints ---
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- app ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- images (used by compose.prod.yaml; never :latest) ---
IMAGE_TAG=dev
REGISTRY=ghcr.io/ammar-yasar-267
